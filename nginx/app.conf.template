# 1. Tự động chuyển HTTP sang HTTPS
server {
    listen 80;
    server_name ${ROOT_DOMAIN} *.${ROOT_DOMAIN};
    return 301 https://$host$request_uri;
}

# 2. Một cổng HTTPS duy nhất phục vụ cả Frontend lẫn Backend (Same-Origin)
server {
    listen 443 ssl;
    http2 on;
    server_name ${ROOT_DOMAIN} *.${ROOT_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${ROOT_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${ROOT_DOMAIN}/privkey.pem;

    client_max_body_size 25m;

    # Đẩy toàn bộ request /api/* vào Go Backend
    location /api/ {
        proxy_pass http://salon-server:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 86400s;
    }

    # Đẩy các request giao diện còn lại vào Next.js Frontend
    location / {
        proxy_pass http://salon-client:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}