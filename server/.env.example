APP_ENV=development
PORT=8080
GIN_MODE=debug

API_BASE_PATH=/api/v1
SERVER_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://app.localhost:3000

JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE=60m
REFRESH_TOKEN_EXPIRE=168h
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_DOMAIN=

DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=salon_db
DB_PORT=5432
DB_URL=postgres://postgres:postgres@localhost:5432/salon_db?sslmode=disable

# Cloudflare R2 (tuỳ chọn — chỉ cần khi dùng tính năng lưu trữ tệp)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_ACCESS_KEY_SECRET=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
