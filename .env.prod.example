
# ===== Domain / Nginx =====
# Domain gốc dùng cho chứng chỉ Let's Encrypt: /etc/letsencrypt/live/<ROOT_DOMAIN>/
ROOT_DOMAIN=example.com

# ===== App =====
APP_ENV=production
PORT=8080
GIN_MODE=release
API_BASE_PATH=/api/v1
SERVER_URL=https://example.com
CORS_ALLOWED_ORIGINS=https://example.com,https://app.example.com

# ===== Docker images (GHCR) =====
# Thay <owner> bằng GitHub owner, ví dụ ghcr.io/daidat02/salon-server:latest
SERVER_IMAGE=ghcr.io/<owner>/salon-server:latest
CLIENT_IMAGE=ghcr.io/<owner>/salon-client:latest

# ===== JWT =====
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE=15m
REFRESH_TOKEN_EXPIRE=168h
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_DOMAIN=

# ===== Database =====
# DB_URL phải trỏ tới service `postgres` trong compose, không dùng localhost.
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=salon_db
DB_PORT=5432
DB_URL=postgres://postgres:change-me@postgres:5432/salon_db?sslmode=disable

# ===== Cloudflare R2 (tuỳ chọn) =====
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_ACCESS_KEY_SECRET=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
